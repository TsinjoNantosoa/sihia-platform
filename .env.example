# Docker Compose — pgAdmin (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@sihia.health
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
# Port hôte Postgres SIH IA (évite conflit avec PostgreSQL Windows sur 5432)
POSTGRES_PORT=5434
JWT_SECRET=dev-docker-secret-minimum-32-chars

# RAG / Qdrant
RAG_ENABLED=true
RAG_TOP_K=10
RAG_FINAL_K=5
RAG_SCORE_THRESHOLD=0.25
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_RERANK_ENABLED=true
RAG_HYBRID_ENABLED=true
RAG_MAX_UPLOAD_MB=20
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sihia_medical_knowledge

# Hosted defaults. Set EMBEDDING_PROVIDER=local for optional FastEmbed mode.
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
